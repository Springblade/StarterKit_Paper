    <h3 className=\"mt-4 text-lg font-medium\">{STRINGS.emptyTitle}</h3>\r\n          <p className=\"mt-1 text-sm text-muted-foreground\">{STRINGS.emptyBody}</p>\r\n          <Link\r\n            href=\"/dashboard/billing\"\r\n            className=\"mt-6 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90\"\r\n          >\r\n            {STRINGS.selectPlan}\r\n          </Link>\r\n        </div>\r\n      ) : (\r\n        <div className=\"rounded-lg border\">\r\n          <table className=\"w-full\">\r\n            <thead className=\"border-b bg-muted/50\">\r\n              <tr>\r\n                <th className=\"px-4 py-3 text-left text-sm font-medium\">{STRINGS.tableHeaders.transactionCode}</th>\r\n                <th className=\"px-4 py-3 text-left text-sm font-medium\">{STRINGS.tableHeaders.plan}</th>\r\n                <th className=\"px-4 py-3 text-left text-sm font-medium\">{STRINGS.tableHeaders.amount}</th>\r\n                <th className=\"px-4 py-3 text-left text-sm font-medium\">{STRINGS.tableHeaders.date}</th>\r\n                <th className=\"px-4 py-3 text-left text-sm font-medium\">{STRINGS.tableHeaders.status}</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              {userOrders.map((order) => (\r\n                <tr key={order.id} className=\"border-b last:border-0\">\r\n                  <td className=\"px-4 py-3 text-sm font-mono\">{order.code}</td>\r\n                  <td className=\"px-4 py-3 text-sm\">{order.plan.name}</td>\r\n                  <td className=\"px-4 py-3 text-sm\">{Number(order.amountVnd).toLocaleString('vi-VN')} VND</td>\r\n                  <td className=\"px-4 py-3 text-sm\">{new Date(order.createdAt).toLocaleDateString('vi-VN')}</td>\r\n                  <td className=\"px-4 py-3 text-sm\">\r\n                    <OrderStatusBadge status={order.status} />\r\n                  </td>\r\n                </tr>\r\n              ))}\r\n            </tbody>\r\n          </table>\r\n        </div>\r\n      )}\r\n\r\n      <div className=\"mt-6\">\r\n        <Link\r\n          href=\"/dashboard/billing\"\r\n          className=\"inline-flex items-center gap-2 rounded-lg border bg-card px-4 py-2 text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground\"\r\n        >\r\n          <ArrowLeft className=\"h-4 w-4\" />\r\n          {STRINGS.backLink}\r\n        </Link>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n'use server';\r\n\r\nimport { and, desc, eq } from 'drizzle-orm';\r\nimport { z } from 'zod';\r\nimport { db } from '@/database/db';\r\nimport { orders } from '@/database/schema';\r\nimport { getSession } from '@/features/auth/lib/auth';\r\nimport { BillingError } from '../errors';\r\n\r\nconst ListOrdersParamsSchema = z.object({\r\n  status: z.enum(['pending', 'completed', 'expired', 'cancelled']).optional(),\r\n  limit: z.number().int().positive().max(50).optional(),\r\n});\r\n\r\nexport type ListOrdersParams = z.input<typeof ListOrdersParamsSchema>;\r\n\r\nexport async function listOrders(params?: z.infer<typeof ListOrdersParamsSchema>) {\r\n  const session = await getSession();\r\n  if (!session) throw new BillingError('UNAUTHORIZED');\r\n\r\n  const parsed = ListOrdersParamsSchema.parse(params ?? {});\r\n\r\n  const whereClause = and(\r\n    eq(orders.userId, session.user.id),\r\n    parsed.status ? eq(orders.status, parsed.status) : undefined,\r\n  );\r\n\r\n  const ordersList = await db.query.orders.findMany({\r\n    where: whereClause,\r\n    with: {\r\n      plan: true,\r\n      user: {\r\n        columns: {\r\n          id: true,\r\n          email: true,\r\n          name: true,\r\n        },\r\n      },\r\n    },\r\n    orderBy: [desc(orders.createdAt)],\r\n    limit: parsed.limit,\r\n  });\r\n\r\n  return ordersList;\r\n}\r\n{\r\n  \"name\": \"smartkit\",\r\n  \"version\": \"0.1.0\",\r\n  \"private\": true,\r\n  \"packageManager\": \"pnpm@11.7.0\",\r\n  \"engines\": {\r\n    \"node\": \">=22.0.0\",\r\n    \"pnpm\": \">=10.0.0\"\r\n  },\r\n  \"scripts\": {\r\n    \"dev\": \"next dev\",\r\n    \"build\": \"next build\",\r\n    \"start\": \"next start\",\r\n    \"lint\": \"biome check .\",\r\n    \"lint:fix\": \"biome check --write .\",\r\n    \"format\": \"biome format --write .\",\r\n    \"check-types\": \"tsc --noEmit\",\r\n    \"test\": \"vitest\",\r\n    \"test:ui\": \"vitest --ui\",\r\n    \"test:coverage\": \"vitest --coverage\",\r\n    \"test:run\": \"vitest run\",\r\n    \"db:generate\": \"drizzle-kit generate\",\r\n    \"db:migrate\": \"drizzle-kit migrate\",\r\n    \"db:studio\": \"drizzle-kit studio\",\r\n    \"db:push\": \"drizzle-kit push\",\r\n    \"db:backfill-journal\": \"tsx scripts/backfill-drizzle-journal.ts\",\r\n    \"db:seed\": \"tsx scripts/seed.ts\",\r\n    \"pretest:billing\": \"tsx scripts/ensure-server-only-shim.ts\",\r\n    \"test:billing\": \"tsx scripts/test-billing-scenarios.ts\",\r\n    \"test:sepay\": \"tsx scripts/test-sepay.ts\",\r\n    \"test:sepay-qr-url\": \"tsx scripts/test-sepay-qr-url.ts\",\r\n    \"test:behavior\": \"vitest run --config vitest.orders.config.ts\"\r\n  },\r\n  \"dependencies\": {\r\n    \"bcryptjs\": \"^3.0.3\",\r\n    \"better-auth\": \"^1.6.25\",\r\n    \"clsx\": \"^2.1.1\",\r\n    \"dotenv\": \"^17.4.2\",\r\n    \"drizzle-kit\": \"^0.31.10\",\r\n    \"drizzle-orm\": \"^0.45.2\",\r\n    \"lucide-react\": \"^1.31.0\",\r\n    \"nanoid\": \"^6.0.0\",\r\n    \"next\": \"16.2.12\",\r\n    \"next-themes\": \"^0.4.6\",\r\n    \"pg\": \"^8.22.0\",\r\n    \"react\": \"18.3.1\",\r\n    \"react-dom\": \"18.3.1\",\r\n    \"react-email\": \"6.9.1\",\r\n    \"resend\": \"^6.18.1\",\r\n    \"tailwind-merge\": \"^3.6.0\",\r\n    \"zod\": \"^4.4.3\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"@better-auth/drizzle-adapter\": \"^1.6.25\",\r\n    \"@biomejs/biome\": \"2.5.6\",\r\n    \"@tailwindcss/postcss\": \"^4.3.3\",\r\n    \"@testing-library/jest-dom\": \"^7.0.1\",\r\n    \"@testing-library/react\": \"^16.3.2\",\r\n    \"@testing-library/user-event\": \"^14.6.6\",\r\n    \"@types/bcryptjs\": \"^3.0.0\",\r\n    \"@types/node\": \"^26\",\r\n    \"@types/pg\": \"^8.20.0\",\r\n    \"@types/react\": \"^18.3.1\",\r\n    \"@types/react-dom\": \"^18.3.1\",\r\n    \"@vitejs/plugin-react\": \"^6.1.0\",\r\n    \"@vitest/ui\": \"^4.1.11\",\r\n    \"happy-dom\": \"^20.11.8\",\r\n    \"jsdom\": \"^30.0.1\",\r\n    \"tailwindcss\": \"^4.3.3\",\r\n    \"tsx\": \"^4.22.4\",\r\n    \"typescript\": \"5.7.3\",\r\n    \"vitest\": \"^4.1.11\"\r\n  }\r\n}\r\nimport { describe, expect, it } from 'vitest';\r\nimport { extractOrderCode, generatePaymentContent } from '@/features/billing/payment-content';\r\n\r\ndescribe('payment-content', () => {\r\n  describe('extractOrderCode', () => {\r\n    it('extracts order code from valid payment content', () => {\r\n      expect(extractOrderCode('SK abc12345')).toBe('abc12345');\r\n    });\r\n\r\n    it('returns null when prefix is missing', () => {\r\n      expect(extractOrderCode('abc12345')).toBeNull();\r\n    });\r\n\r\n    it('returns null when code is too short', () => {\r\n      expect(extractOrderCode('SK abcd')).toBeNull();\r\n    });\r\n  });\r\n\r\n  describe('generatePaymentContent', () => {\r\n    it('embeds order code with SK prefix', () => {\r\n      expect(generatePaymentContent('abc12345')).toBe('SK abc12345');\r\n    });\r\n  });\r\n});\r\n","exit_code":0,"status":"completed"}}
